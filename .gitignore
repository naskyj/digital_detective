# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
/dist/
/build/
# Collector memory tools + fetch receipt — populated per build box by
# scripts/fetch_collector_tools.py. WinPmem is Apache-2.0 and may be vendored
# for a fully offline build: `git add -f packaging/tools/winpmem.exe`.
# ProcDump (Sysinternals) / DumpIt (Magnet) licenses restrict redistribution.
packaging/tools/
.pytest_cache/
.ruff_cache/

# Node / frontend
node_modules/
packages/lab/dd_lab/ui/dist/

# Models / data / evidence — never commit
model/corpus/data/
model/**/*.onnx
model/**/*.safetensors
model/**/*.bin
evidence_samples/
cases/

# Per-case exports from scripts/export_for_labeling.py — derived from real
# evidence, regenerable from the case + script; never commit the bulk export
# (as a directory or zipped/archived up for moving around). A final,
# manually-curated gold set is a deliberate exception (add it explicitly
# with `git add -f` if you want that small file tracked).
model/eval/*/
model/eval/*.zip
model/eval/*.tar.gz
*.duckdb
*.dmp
*.raw

# Large reference media
docs/reference/*.mov
docs/reference/*.mp4

# Secrets / local config
.env
*.key
config.local.*
gcs.json

# Private material — never tracked (paper drafts, working notes, handoffs)
docs/
PLAN.md
STATUS.md
RUNNING.md

# Paper-reproduction and docs-generating scripts — kept local only
scripts/ablation.py
scripts/audit_paper_sections.py
scripts/baseline_tfidf.py
scripts/operating_points.py
scripts/render_paper.py
scripts/schema_json.py
scripts/paper_metrics.py
scripts/apply_rule_change.py
scripts/export_labelled.py
scripts/tests/test_schema_json.py
scripts/_bounded_tools.py
scripts/eval_*.py
scripts/export_classified.py
scripts/make_label_sample.py
scripts/transformer_figures.py
