# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
/dist/
/build/
packaging/tools/*
# WinPmem is Apache-2.0 and may be vendored for a fully offline build.
# Run scripts/fetch_collector_tools.py first, then `git add -f` it if you want that.
!packaging/tools/TOOLS.md
# ProcDump / DumpIt: Sysinternals / Comae licenses restrict redistribution —
# keep them out of the repo; each build box fetches them with the script.
.pytest_cache/
.ruff_cache/

# Node / frontend
node_modules/
packages/lab/dd_lab/ui/dist/

# Models / data / evidence — never commit
model/corpus/data/
model/**/*.onnx
model/**/*.safetensors
model/**/*.bin
evidence_samples/
cases/
*.duckdb
*.dmp
*.raw

# Large reference media
docs/reference/*.mov
docs/reference/*.mp4

# Secrets / local config
.env
*.key
config.local.*
gcs.json
