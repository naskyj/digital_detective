# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
/dist/
/build/
# Collector memory tools + fetch receipt — populated per build box by
# scripts/fetch_collector_tools.py. WinPmem is Apache-2.0 and may be vendored
# for a fully offline build: `git add -f packaging/tools/winpmem.exe`.
# ProcDump (Sysinternals) / DumpIt (Magnet) licenses restrict redistribution.
packaging/tools/
.pytest_cache/
.ruff_cache/

# Node / frontend
node_modules/
packages/lab/dd_lab/ui/dist/

# Models / data / evidence — never commit
model/corpus/data/
model/**/*.onnx
model/**/*.safetensors
model/**/*.bin
evidence_samples/
cases/

# Per-case exports from scripts/export_for_labeling.py — derived from real
# evidence, regenerable from the case + script; never commit the bulk export
# (as a directory or zipped/archived up for moving around). A final,
# manually-curated gold set is a deliberate exception (add it explicitly
# with `git add -f` if you want that small file tracked).
model/eval/*/
model/eval/*.zip
model/eval/*.tar.gz
*.duckdb
*.dmp
*.raw

# Large reference media
docs/reference/*.mov
docs/reference/*.mp4

# Secrets / local config
.env
*.key
config.local.*
gcs.json
